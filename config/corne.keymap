#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hmr_l: hmr_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        hmr_r: hmr_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp Q           &kp W          &kp E          &kp R            &kp T        &kp Y        &kp U            &kp I          &kp O          &kp P                      &none
&none  &hmr_l LCTRL A  &hmr_l LALT S  &hmr_l LGUI D  &hmr_l LSHIFT F  &kp G        &kp H        &hmr_r RSHIFT J  &hmr_r RGUI K  &hmr_r RALT L  &hmr_r RCTRL SINGLE_QUOTE  &none
&none  &kp Z           &kp X          &kp C          &kp V            &kp B        &kp N        &kp M            &kp COMMA      &kp DOT        &kp FSLH                   &none
                                      &none          &lt 1 BACKSPACE  &lt 2 TAB    &lt 2 ENTER  &lt 1 SPACE      &none
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp EXCL           &kp AT              &kp LEFT_PARENTHESIS      &kp RIGHT_PARENTHESIS            &kp PIPE     &kp PLUS   &kp N7                &kp N8          &kp N9          &kp STAR   &none
&none  &hmr_l LCTRL HASH  &hmr_l LALT DOLLAR  &hmr_l LGUI LEFT_BRACKET  &hmr_l LEFT_SHIFT RIGHT_BRACKET  &kp AMPS     &kp EQUAL  &hmr_r LEFT_SHIFT N4  &hmr_r RGUI N5  &hmr_r RALT N6  &kp SEMI   &none
&none  &kp PERCENT        &kp CARET           &kp LEFT_BRACE            &kp RIGHT_BRACE                  &kp TILDE    &kp MINUS  &kp N1                &kp NUMBER_2    &kp N3          &kp SLASH  &none
                                              &none                     &kp BACKSLASH                    &kp GRAVE    &kp DOT    &kp N0                &none
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &none                &none               &none                     &none                 &none     &none     &none          &none        &none      &none  &none
&none  &hmr_l LCTRL ESCAPE  &hmr_l LALT K_PREV  &hmr_l LGUI K_PLAY_PAUSE  &hmr_l LSHIFT K_NEXT  &none     &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none  &none
&none  &none                &none               &none                     &none                 &none     &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &none  &none
                                                &none                     &trans                &trans    &trans    &trans         &none
            >;
        };
    };
};
